# Recommended: Google Gemini API
# Easiest setup: paste the key in FiFo AI -> Edit My Profile -> Gemini AI.
# That stores the key only in the browser extension's local storage and sends it to the local API per request.
# Alternative server-side setup: put the key here in apps/api/.env (never commit the real key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional override. Normally leave this unchanged.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional fallback: any OpenAI-compatible LLM endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local storage path
FIFO_DB_PATH=./data/fifo.db
