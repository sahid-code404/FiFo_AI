# Recommended: Google Gemini API
# Create a key in Google AI Studio and keep the real key only in apps/api/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional override. Normally leave this unchanged.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional fallback: any OpenAI-compatible LLM endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local storage path
FIFO_DB_PATH=./data/fifo.db
