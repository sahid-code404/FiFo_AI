{
  "manifest_version": 3,
  "name": "FiFo AI",
  "description": "AI-assisted job and application form autofill with grounded Gemini drafts and review-first safety.",
  "version": "0.7.0",
  "permissions": ["storage", "activeTab", "tabs", "webNavigation"],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FiFo AI"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:8000/*"],
      "js": ["content.js", "ai_fill.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}